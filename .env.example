# Copy to .env for local development, or add these in Vercel →
# Project → Settings → Environment Variables. Only ADMIN_PASSWORD is required.

# ── Required ─────────────────────────────────────────────
ADMIN_PASSWORD=choose-a-long-password

# ── Publishing from the live site (free) ────────────────
# Fine-grained GitHub token with "Contents: Read and write" on this repo.
GITHUB_TOKEN=
# Usually auto-detected on Vercel. Set if needed: owner/repo and branch.
GITHUB_REPO=
GITHUB_BRANCH=main

# ── AI writing (pick one; Gemini has a free tier) ───────
GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=            # paid per use; OPENAI_MODEL overrides the model (default gpt-5-mini)
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=gemini        # gemini | groq | openai | anthropic

# ── Newsletter (Buttondown, free up to 100 subscribers) ─
BUTTONDOWN_API_KEY=
# NEWSLETTER_AUTOSEND=true   # send automatically instead of saving drafts

# ── Daily automation ─────────────────────────────────────
CRON_SECRET=any-long-random-string
# AUTO_DRAFT_COUNT=2          # AI article drafts written each morning (0 to turn off)
# AUTO_PUBLISH=false          # true = publish AI drafts without review (not recommended)

# ── Optional ─────────────────────────────────────────────
# SITE_URL=https://tensorstreet.com
# INSTAGRAM_HANDLE=tensorstreet
# FINNHUB_API_KEY=            # backup market data source
# SITE_TIMEZONE=America/New_York
