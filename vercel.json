{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "{content/**,pages/*.html}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 10 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/admin/:action",
      "destination": "/api/admin?action=:action"
    },
    {
      "source": "/api/cron/:job",
      "destination": "/api/cron?job=:job"
    },
    {
      "source": "/api/:action",
      "destination": "/api/public?action=:action"
    },
    {
      "source": "/media/:path*",
      "destination": "/api/public?action=media&path=:path*"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/public?action=rss"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/public?action=sitemap"
    },
    {
      "source": "/",
      "destination": "/api/public?action=html&kind=index"
    },
    {
      "source": "/about",
      "destination": "/api/public?action=html&kind=about"
    },
    {
      "source": "/learn",
      "destination": "/api/public?action=html&kind=learn"
    },
    {
      "source": "/archive",
      "destination": "/api/public?action=html&kind=archive"
    },
    {
      "source": "/search",
      "destination": "/api/public?action=html&kind=search"
    },
    {
      "source": "/brand",
      "destination": "/api/public?action=html&kind=brand"
    },
    {
      "source": "/post",
      "destination": "/api/public?action=html&kind=postpreview"
    },
    {
      "source": "/topics",
      "destination": "/api/public?action=html&kind=topics"
    },
    {
      "source": "/archive/:date",
      "destination": "/api/public?action=html&kind=archiveDate&date=:date"
    },
    {
      "source": "/section/:id",
      "destination": "/api/public?action=html&kind=section&id=:id"
    },
    {
      "source": "/story/:id",
      "destination": "/api/public?action=html&kind=story&id=:id"
    },
    {
      "source": "/topic/:slug",
      "destination": "/api/public?action=html&kind=topic&slug=:slug"
    },
    {
      "source": "/p/:slug",
      "destination": "/api/public?action=html&kind=p&slug=:slug"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/public?action=robots"
    },
    {
      "source": "/news-sitemap.xml",
      "destination": "/api/public?action=newssitemap"
    },
    {
      "source": "/indexnow-key.txt",
      "destination": "/api/public?action=indexnowkey"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(js|css)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(brand|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(site|admin).webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)content'"
}
